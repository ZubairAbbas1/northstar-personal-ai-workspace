# ====================================================
# AI Productivity Workspace - Environment Configuration
# ====================================================

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (set in frontend/.env.local when the API is hosted separately)
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workspace_db
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=northstar
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=northstar

# Security & Authentication (replace both values before ENVIRONMENT=production)
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-secure-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Secret Encryption Vault (Fernet / AES-256-GCM 32-byte Base64 key for BYOK & OAuth tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Platform Default AI Keys (Optional if users use BYOK)
USE_PLATFORM_AI=true
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-productivity-workspace

# Third-Party OAuth Clients
# Google callback: {BACKEND_PUBLIC_URL}/api/v1/integrations/google/callback
# GitHub callback: {BACKEND_PUBLIC_URL}/api/v1/integrations/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
